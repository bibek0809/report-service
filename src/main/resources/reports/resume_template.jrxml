<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd
                                  http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
              name="resume_template" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="24" bottomMargin="24" uuid="7a2e2c1a-1111-4a2b-9c3d-000000000001">

    <property name="net.sf.jasperreports.export.pdf.embedded" value="true"/>

    <!-- ===================== Nested dataset: Experience ===================== -->
    <subDataset name="ExperienceDataset" uuid="7a2e2c1a-1111-4a2b-9c3d-000000000002">
        <field name="company" class="java.lang.String"/>
        <field name="role" class="java.lang.String"/>
        <field name="location" class="java.lang.String"/>
        <field name="dateRange" class="java.lang.String"/>
        <field name="highlightsText" class="java.lang.String"/>
    </subDataset>

    <!-- ===================== Nested dataset: Education ===================== -->
    <subDataset name="EducationDataset" uuid="7a2e2c1a-1111-4a2b-9c3d-000000000003">
        <field name="institution" class="java.lang.String"/>
        <field name="degree" class="java.lang.String"/>
        <field name="location" class="java.lang.String"/>
        <field name="dateRange" class="java.lang.String"/>
        <field name="details" class="java.lang.String"/>
    </subDataset>

    <parameter name="P_FULL_NAME" class="java.lang.String"/>
    <parameter name="P_JOB_TITLE" class="java.lang.String"/>
    <parameter name="P_EMAIL" class="java.lang.String"/>
    <parameter name="P_PHONE" class="java.lang.String"/>
    <parameter name="P_LOCATION" class="java.lang.String"/>
    <parameter name="P_LINKEDIN" class="java.lang.String"/>
    <parameter name="P_WEBSITE" class="java.lang.String"/>
    <parameter name="P_SUMMARY" class="java.lang.String"/>
    <parameter name="P_EXPERIENCE" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>
    <parameter name="P_EDUCATION" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>
    <parameter name="P_SKILLS_TEXT" class="java.lang.String"/>
    <parameter name="P_CERTIFICATIONS_TEXT" class="java.lang.String"/>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="90" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="535" height="30" forecolor="#1F2937"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000010"/>
                <textElement/>
                <textFieldExpression><![CDATA[$P{P_FULL_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="30" width="535" height="18" forecolor="#4B5563"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000011"/>
                <textElement/>
                <textFieldExpression><![CDATA[$P{P_JOB_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="52" width="535" height="16" forecolor="#6B7280"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000012"/>
                <textElement/>
                <textFieldExpression><![CDATA[
                    ($P{P_EMAIL}==null||$P{P_EMAIL}.isEmpty()?"":$P{P_EMAIL}+"   |   ") +
                    ($P{P_PHONE}==null||$P{P_PHONE}.isEmpty()?"":$P{P_PHONE}+"   |   ") +
                    ($P{P_LOCATION}==null||$P{P_LOCATION}.isEmpty()?"":$P{P_LOCATION}+"   |   ") +
                    ($P{P_LINKEDIN}==null||$P{P_LINKEDIN}.isEmpty()?"":$P{P_LINKEDIN}+"   |   ") +
                    ($P{P_WEBSITE}==null?"":$P{P_WEBSITE})
                ]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="82" width="535" height="1"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000013"/>
                <graphicElement><pen lineWidth="1.5" lineColor="#1F2937"/></graphicElement>
            </line>
        </band>
    </title>

    <detail>
        <!-- === Summary === -->
        <band height="60" splitType="Stretch">
            <printWhenExpression><![CDATA[$P{P_SUMMARY} != null && !$P{P_SUMMARY}.isEmpty()]]></printWhenExpression>
            <staticText>
                <reportElement x="0" y="8" width="535" height="14" forecolor="#1F2937"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000020"/>
                <textElement/>
                <text><![CDATA[SUMMARY]]></text>
            </staticText>
            <textField isStretchWithOverflow="true" textAdjust="StretchHeight">
                <reportElement x="0" y="24" width="535" height="36" forecolor="#374151"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000021"/>
                <textElement/>
                <textFieldExpression><![CDATA[$P{P_SUMMARY}]]></textFieldExpression>
            </textField>
        </band>

        <!-- === Experience header === -->
        <band height="16" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="535" height="14" forecolor="#1F2937"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000030"/>
                <textElement/>
                <text><![CDATA[EXPERIENCE]]></text>
            </staticText>
        </band>

        <!-- === Experience list === -->
        <band height="220" splitType="Prevent">
            <componentElement>
                <reportElement x="0" y="0" width="535" height="220"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000031"/>
                <jr:list printOrder="Vertical">
                    <datasetRun subDataset="ExperienceDataset"
                                uuid="7a2e2c1a-1111-4a2b-9c3d-000000000032">
                        <dataSourceExpression><![CDATA[$P{P_EXPERIENCE}]]></dataSourceExpression>
                    </datasetRun>
                    <jr:listContents height="80" width="535">
                        <textField>
                            <reportElement x="0" y="2" width="380" height="14"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000033"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{role} + "  —  " + $F{company}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="380" y="2" width="155" height="14" forecolor="#6B7280"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000034"/>
                            <textElement textAlignment="Right"/>
                            <textFieldExpression><![CDATA[$F{dateRange}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="0" y="16" width="535" height="12" forecolor="#6B7280"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000035"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{location}]]></textFieldExpression>
                        </textField>
                        <textField isStretchWithOverflow="true" textAdjust="StretchHeight">
                            <reportElement x="0" y="30" width="535" height="48" forecolor="#374151"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000036"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{highlightsText}]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>
        </band>

        <!-- === Education header === -->
        <band height="16" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="535" height="14" forecolor="#1F2937"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000040"/>
                <textElement/>
                <text><![CDATA[EDUCATION]]></text>
            </staticText>
        </band>

        <!-- === Education list === -->
        <band height="110" splitType="Prevent">
            <componentElement>
                <reportElement x="0" y="0" width="535" height="110"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000041"/>
                <jr:list printOrder="Vertical">
                    <datasetRun subDataset="EducationDataset"
                                uuid="7a2e2c1a-1111-4a2b-9c3d-000000000042">
                        <dataSourceExpression><![CDATA[$P{P_EDUCATION}]]></dataSourceExpression>
                    </datasetRun>
                    <jr:listContents height="46" width="535">
                        <textField>
                            <reportElement x="0" y="2" width="380" height="14"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000043"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{degree} + "  —  " + $F{institution}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="380" y="2" width="155" height="14" forecolor="#6B7280"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000044"/>
                            <textElement textAlignment="Right"/>
                            <textFieldExpression><![CDATA[$F{dateRange}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="0" y="16" width="535" height="12" forecolor="#6B7280"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000045"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{location}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="0" y="30" width="535" height="14" forecolor="#374151"
                                           uuid="7a2e2c1a-1111-4a2b-9c3d-000000000046"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{details}]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>
        </band>

        <!-- === Skills === -->
        <band height="46" splitType="Stretch">
            <printWhenExpression><![CDATA[$P{P_SKILLS_TEXT} != null && !$P{P_SKILLS_TEXT}.isEmpty()]]></printWhenExpression>
            <staticText>
                <reportElement x="0" y="0" width="535" height="14" forecolor="#1F2937"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000050"/>
                <textElement/>
                <text><![CDATA[SKILLS]]></text>
            </staticText>
            <textField isStretchWithOverflow="true" textAdjust="StretchHeight">
                <reportElement x="0" y="16" width="535" height="28" forecolor="#374151"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000051"/>
                <textElement/>
                <textFieldExpression><![CDATA[$P{P_SKILLS_TEXT}]]></textFieldExpression>
            </textField>
        </band>

        <!-- === Certifications === -->
        <band height="46" splitType="Stretch">
            <printWhenExpression><![CDATA[$P{P_CERTIFICATIONS_TEXT} != null && !$P{P_CERTIFICATIONS_TEXT}.isEmpty()]]></printWhenExpression>
            <staticText>
                <reportElement x="0" y="0" width="535" height="14" forecolor="#1F2937"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000060"/>
                <textElement/>
                <text><![CDATA[CERTIFICATIONS]]></text>
            </staticText>
            <textField isStretchWithOverflow="true" textAdjust="StretchHeight">
                <reportElement x="0" y="16" width="535" height="28" forecolor="#374151"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000061"/>
                <textElement/>
                <textFieldExpression><![CDATA[$P{P_CERTIFICATIONS_TEXT}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20" splitType="Stretch">
            <textField evaluationTime="Report">
                <reportElement x="0" y="0" width="535" height="16" forecolor="#9CA3AF"
                               uuid="7a2e2c1a-1111-4a2b-9c3d-000000000070"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
