                            <textElement textAlignment="Right"/>
                            <textFieldExpression><![CDATA[$F{url}]]></textFieldExpression>
                        </textField>
                        <textField isStretchWithOverflow="true">
                            <reportElement style="MainTextStyle" x="0" y="18" width="360" height="16" uuid="7a2e2c1a-002a-4a2b-9c3d-123456789abc"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement style="MainTextStyle" x="0" y="36" width="360" height="12" forecolor="#63B3ED" uuid="7a2e2c1a-002b-4a2b-9c3d-123456789abc"/>
                            <textElement/>
                            <textFieldExpression><![CDATA[$F{techStack}]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>
        </band>
    </lastPageFooter>

    <!-- ===================== SUMMARY (Page Numbers) ===================== -->
    <summary>
        <band height="20" splitType="Stretch">
            <textField evaluationTime="Report">
                <reportElement x="220" y="0" width="360" height="16" forecolor="#A0AEC0" uuid="7a2e2c1a-002c-4a2b-9c3d-123456789abc"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of " + $V{PAGE_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>