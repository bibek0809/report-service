<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="employee_report" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">

    <!-- Parameters: single values supplied by the caller, independent of the row data -->
    <parameter name="ReportTitle" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Employee Report"]]></defaultValueExpression>
    </parameter>
    <parameter name="GeneratedBy" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Report Service"]]></defaultValueExpression>
    </parameter>

    <!-- Fields: must match the getters on EmployeeDto (name -> getName(), etc.) -->
    <field name="name" class="java.lang.String"/>
    <field name="department" class="java.lang.String"/>
    <field name="salary" class="java.lang.Double"/>

    <title>
        <band height="60">
            <textField>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement>
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ReportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="32" width="535" height="18"/>
                <textElement>
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by " + $P{GeneratedBy} + " on " + new java.text.SimpleDateFormat("yyyy-MM-dd").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="235" height="20"/>
                <box><bottomPen lineWidth="1.0"/></box>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="235" y="0" width="200" height="20"/>
                <box><bottomPen lineWidth="1.0"/></box>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Department]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="0" width="100" height="20"/>
                <box><bottomPen lineWidth="1.0"/></box>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Salary]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="235" height="18"/>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="235" y="0" width="200" height="18"/>
                <textFieldExpression><![CDATA[$F{department}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="435" y="0" width="100" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{salary}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="30">
            <textField>
                <reportElement x="0" y="5" width="535" height="20"/>
                <textElement textAlignment="Right">
                    <font isItalic="true" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Total employees: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
